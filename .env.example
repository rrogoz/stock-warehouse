# Local DEV settings. Copy to .env (gitignored) and fill in DEV values only.
# PROD values live in the GitHub environment prod-run, never on a laptop (ADR-002).

# Storage: Cloudflare R2, S3-compatible (ADR-003)
SW_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
SW_STORAGE_BUCKET=sw-dev
SW_STORAGE_ACCESS_KEY_ID=
SW_STORAGE_SECRET_ACCESS_KEY=

# Jira, used by the Jira script (ADR-010, ADR-011)
JIRA_BASE_URL=https://rrogoz-sw.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
